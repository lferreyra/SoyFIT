rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test document
    match /test/{docId} {
      allow get: if true;
    }

    // Global security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('age' in data) || (data.age is number && data.age >= 0 && data.age <= 130)) &&
             (!('heightCm' in data) || (data.heightCm is number && data.heightCm >= 40 && data.heightCm <= 300)) &&
             (!('weightKg' in data) || (data.weightKg is number && data.weightKg >= 20 && data.weightKg <= 500));
    }

    // Validation Blueprint for WorkoutSession
    function isValidWorkoutSession(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.workoutTitle is string && data.workoutTitle.size() <= 128 &&
             data.durationSeconds is number && data.durationSeconds >= 0 &&
             (!('caloriesBurned' in data) || (data.caloriesBurned is number && data.caloriesBurned >= 0)) &&
             (!('xpEarned' in data) || (data.xpEarned is number && data.xpEarned >= 0));
    }

    // Validation Blueprint for Gamification State
    function isValidGamification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.xp is number && data.xp >= 0 &&
             (!('currentStreakDays' in data) || (data.currentStreakDays is number && data.currentStreakDays >= 0));
    }

    // User Profile Document and Subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Workouts Subcollection
      match /workouts/{workoutId} {
        allow get: if isOwner(userId) && isValidId(workoutId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(workoutId) && isValidWorkoutSession(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(workoutId) && isValidWorkoutSession(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(workoutId);
      }

      // Gamification Subcollection
      match /gamification/{stateId} {
        allow get: if isOwner(userId) && isValidId(stateId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(stateId) && isValidGamification(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(stateId) && isValidGamification(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(stateId);
      }
    }
  }
}
